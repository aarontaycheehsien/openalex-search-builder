# OpenAlex API key (free tier available at https://openalex.org/settings/api)
# Docs: https://help.openalex.org/api/authentication/
#
# Copy to .env (already gitignored) or export in your shell:
#   macOS / Linux:  export OPENALEX_API_KEY="your-key-here"
#   PowerShell:     $env:OPENALEX_API_KEY="your-key-here"
#
# Typical cost for a full interactive search build: ~$0.07-$0.15 in OpenAlex credits.
# For offline drafting without a key, use `lint` and `draft` (zero API calls).
OPENALEX_API_KEY=
